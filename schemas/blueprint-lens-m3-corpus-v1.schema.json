{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m3-corpus-v1.schema.json",
  "title": "Blueprint Lens M3 Corpus Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "regression_assets",
    "candidate_graphs"
  ],
  "properties": {
    "schema_name": { "const": "blueprint-lens-m3-corpus" },
    "schema_version": { "const": "1.0.0" },
    "regression_assets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/regression_asset" }
    },
    "candidate_graphs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate_graph" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "object_path": {
      "type": "string",
      "pattern": "^/Game/[A-Za-z0-9_./]+\\.[A-Za-z0-9_]+$"
    },
    "regression_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object_path": { "$ref": "#/$defs/object_path" }
      }
    },
    "candidate_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_path", "graph_id", "band", "risk_dimensions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object_path": { "$ref": "#/$defs/object_path" },
        "graph_id": { "$ref": "#/$defs/id" },
        "band": { "enum": ["small", "medium", "large"] },
        "risk_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_traceability_and_progressive_disclosure",
              "branching_and_incomparable_outcomes",
              "data_provenance_fan_in_fan_out",
              "sequence_async_completion_and_synchronization",
              "call_and_context",
              "opaque_unsupported_and_query_budget_boundaries",
              "cycles_and_multiple_sccs",
              "small_medium_large_scale"
            ]
          }
        }
      }
    }
  }
}
