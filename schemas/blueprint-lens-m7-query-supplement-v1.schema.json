{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m7-query-supplement-v1.schema.json",
  "title": "Blueprint Lens M7 supplementary query set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "frozen_on",
    "supplements",
    "selection_rule",
    "corpus_manifest",
    "query_set_sha256",
    "queries"
  ],
  "properties": {
    "schema_name": {
      "const": "blueprint-lens-m7-query-supplement"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "frozen_on": {
      "$ref": "#/$defs/date"
    },
    "supplements": {
      "$ref": "#/$defs/frozen_queries_pin"
    },
    "selection_rule": {
      "$ref": "#/$defs/selection_rule"
    },
    "corpus_manifest": {
      "$ref": "#/$defs/corpus_manifest"
    },
    "query_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "non_empty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"
    },
    "frozen_queries_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "query_set_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portable_path"
        },
        "query_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "corpus_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portable_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "execution_tie_break",
        "data",
        "data_tie_break",
        "consults_outcomes",
        "note"
      ],
      "properties": {
        "execution": {
          "$ref": "#/$defs/non_empty"
        },
        "execution_tie_break": {
          "$ref": "#/$defs/non_empty"
        },
        "data": {
          "$ref": "#/$defs/non_empty"
        },
        "data_tie_break": {
          "$ref": "#/$defs/non_empty"
        },
        "consults_outcomes": {
          "const": false
        },
        "note": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "dimension": {
      "enum": [
        "source_traceability_and_progressive_disclosure",
        "branching_and_incomparable_outcomes",
        "data_provenance_fan_in_fan_out",
        "sequence_async_completion_and_synchronization",
        "call_and_context",
        "opaque_unsupported_and_query_budget_boundaries",
        "cycles_and_multiple_sccs",
        "small_medium_large_scale"
      ]
    },
    "risk_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "execution_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "criterion_node_id",
        "description",
        "risk_dimensions",
        "annotation_scope",
        "backward_chain_depth"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "execution"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "criterion_node_id": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "whole_graph"
        },
        "backward_chain_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "data_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "member_guid",
        "member_name",
        "description",
        "risk_dimensions",
        "annotation_scope"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "data"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "member_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "member_name": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "whole_graph"
        }
      }
    },
    "query": {
      "oneOf": [
        {
          "$ref": "#/$defs/execution_query"
        },
        {
          "$ref": "#/$defs/data_query"
        }
      ]
    }
  }
}
