{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m7-ground-truth-v1.schema.json",
  "title": "Blueprint Lens M7 Ground Truth Registry and Frozen Queries v1",
  "oneOf": [
    {
      "$ref": "#/$defs/registry_document"
    },
    {
      "$ref": "#/$defs/query_document"
    }
  ],
  "$defs": {
    "non_empty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^M7-TRUTH-[A-Z0-9-]+$"
    },
    "slice_kind": {
      "enum": [
        "execution",
        "data"
      ]
    },
    "counterpart": {
      "oneOf": [
        {
          "const": null
        },
        {
          "$ref": "#/$defs/entry_id"
        }
      ]
    },
    "registry_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_id",
            "path",
            "sha256",
            "slice_kind",
            "producer",
            "produced_on",
            "independence_model",
            "adjudication_state",
            "counterpart_entry_id",
            "notes"
          ],
          "properties": {
            "entry_id": {
              "$ref": "#/$defs/entry_id"
            },
            "path": {
              "$ref": "#/$defs/portable_path"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "slice_kind": {
              "$ref": "#/$defs/slice_kind"
            },
            "producer": {
              "$ref": "#/$defs/non_empty"
            },
            "produced_on": {
              "$ref": "#/$defs/date"
            },
            "independence_model": {
              "enum": [
                "single_source",
                "independent_review"
              ]
            },
            "adjudication_state": {
              "const": "not_applicable"
            },
            "counterpart_entry_id": {
              "const": null
            },
            "notes": {
              "$ref": "#/$defs/non_empty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_id",
            "path",
            "sha256",
            "slice_kind",
            "producer",
            "produced_on",
            "independence_model",
            "adjudication_state",
            "counterpart_entry_id",
            "notes"
          ],
          "properties": {
            "entry_id": {
              "$ref": "#/$defs/entry_id"
            },
            "path": {
              "$ref": "#/$defs/portable_path"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "slice_kind": {
              "$ref": "#/$defs/slice_kind"
            },
            "producer": {
              "$ref": "#/$defs/non_empty"
            },
            "produced_on": {
              "$ref": "#/$defs/date"
            },
            "independence_model": {
              "const": "independent_rederivation"
            },
            "adjudication_state": {
              "enum": [
                "pending",
                "agreed",
                "adjudicated"
              ]
            },
            "counterpart_entry_id": {
              "$ref": "#/$defs/entry_id"
            },
            "notes": {
              "$ref": "#/$defs/non_empty"
            },
            "agrees_with_counterpart": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "dimension": {
      "enum": [
        "source_traceability_and_progressive_disclosure",
        "branching_and_incomparable_outcomes",
        "data_provenance_fan_in_fan_out",
        "sequence_async_completion_and_synchronization",
        "call_and_context",
        "opaque_unsupported_and_query_budget_boundaries",
        "cycles_and_multiple_sccs",
        "small_medium_large_scale"
      ]
    },
    "risk_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "execution_whole_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "criterion_node_id",
        "description",
        "risk_dimensions",
        "annotation_scope"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "execution"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "criterion_node_id": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "whole_graph"
        }
      }
    },
    "execution_bounded_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "criterion_node_id",
        "description",
        "risk_dimensions",
        "annotation_scope",
        "region_note"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "execution"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "criterion_node_id": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "bounded_region"
        },
        "region_note": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "data_whole_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "member_guid",
        "member_name",
        "description",
        "risk_dimensions",
        "annotation_scope"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "data"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "member_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "member_name": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "whole_graph"
        }
      }
    },
    "data_bounded_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "candidate_id",
        "graph_id",
        "member_guid",
        "member_name",
        "description",
        "risk_dimensions",
        "annotation_scope",
        "region_note"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^M7-Q-[A-Z0-9-]+$"
        },
        "slice_kind": {
          "const": "data"
        },
        "candidate_id": {
          "$ref": "#/$defs/non_empty"
        },
        "graph_id": {
          "$ref": "#/$defs/non_empty"
        },
        "member_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "member_name": {
          "$ref": "#/$defs/non_empty"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "risk_dimensions": {
          "$ref": "#/$defs/risk_dimensions"
        },
        "annotation_scope": {
          "const": "bounded_region"
        },
        "region_note": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "query": {
      "oneOf": [
        {
          "$ref": "#/$defs/execution_whole_query"
        },
        {
          "$ref": "#/$defs/execution_bounded_query"
        },
        {
          "$ref": "#/$defs/data_whole_query"
        },
        {
          "$ref": "#/$defs/data_bounded_query"
        }
      ]
    },
    "corpus_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portable_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "registry_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_name": {
          "const": "blueprint-lens-m7-ground-truth"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/registry_entry"
          }
        }
      }
    },
    "query_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "frozen_on",
        "corpus_manifest",
        "query_set_sha256",
        "queries"
      ],
      "properties": {
        "schema_name": {
          "const": "blueprint-lens-m7-queries"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "frozen_on": {
          "$ref": "#/$defs/date"
        },
        "corpus_manifest": {
          "$ref": "#/$defs/corpus_manifest"
        },
        "query_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/query"
          }
        }
      }
    }
  }
}
