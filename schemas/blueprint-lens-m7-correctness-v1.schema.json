{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m7-correctness-v1.schema.json",
  "title": "Blueprint Lens M7 Correctness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "measured_on",
    "truth_basis",
    "limitations",
    "rows",
    "aggregate"
  ],
  "properties": {
    "schema_name": {
      "const": "blueprint-lens-m7-correctness"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "measured_on": {
      "const": "2026-08-22"
    },
    "truth_basis": {
      "$ref": "#/$defs/truth_basis"
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/limitation"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 38,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    }
  },
  "$defs": {
    "non_empty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "query_id": {
      "type": "string",
      "pattern": "^M7-Q-[A-Z0-9-]+$"
    },
    "slice_kind": {
      "enum": [
        "execution",
        "data"
      ]
    },
    "identity_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty"
      }
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "denominator": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "measurement_side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true_positive",
        "false_positive",
        "false_negative",
        "false_positive_ids",
        "false_negative_ids",
        "precision",
        "recall"
      ],
      "properties": {
        "true_positive": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "false_positive": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "false_negative": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "false_positive_ids": {
          "$ref": "#/$defs/identity_array"
        },
        "false_negative_ids": {
          "$ref": "#/$defs/identity_array"
        },
        "precision": {
          "$ref": "#/$defs/fraction"
        },
        "recall": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "truth_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication_path",
        "adjudication_sha256",
        "pairs_agreed",
        "pairs_total"
      ],
      "properties": {
        "adjudication_path": {
          "$ref": "#/$defs/non_empty"
        },
        "adjudication_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pairs_agreed": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "pairs_total": {
          "$ref": "#/$defs/non_negative_integer"
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "statement": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "slice_kind",
        "nodes",
        "edges"
      ],
      "properties": {
        "query_id": {
          "$ref": "#/$defs/query_id"
        },
        "slice_kind": {
          "$ref": "#/$defs/slice_kind"
        },
        "nodes": {
          "$ref": "#/$defs/measurement_side"
        },
        "edges": {
          "$ref": "#/$defs/measurement_side"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "exact_match"
      ],
      "properties": {
        "nodes": {
          "$ref": "#/$defs/aggregate_side"
        },
        "edges": {
          "$ref": "#/$defs/aggregate_side"
        },
        "exact_match": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "aggregate_side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "recall"
      ],
      "properties": {
        "precision": {
          "$ref": "#/$defs/fraction"
        },
        "recall": {
          "$ref": "#/$defs/fraction"
        }
      }
    }
  }
}
