{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m10-demo-case-matrix-v1.schema.json",
  "title": "Blueprint Lens M10 composition demo case matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "asset", "cases", "lc5_scroll_coverage", "limitations"],
  "properties": {
    "schema_name": {"const": "blueprint-lens-m10-demo-case-matrix"},
    "schema_version": {"const": "1.0.0"},
    "asset": {"$ref": "#/$defs/asset"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/case"}
    },
    "lc5_scroll_coverage": {"$ref": "#/$defs/coverage"},
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty"}
    }
  },
  "$defs": {
    "non_empty": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_path", "content_path", "typed_ir_path"],
      "properties": {
        "object_path": {"$ref": "#/$defs/non_empty"},
        "content_path": {"$ref": "#/$defs/path"},
        "typed_ir_path": {"$ref": "#/$defs/path"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "graph_id", "criterion_label", "query_direction", "surface", "purpose", "explanation_path", "screenshot_paths"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^M10-DEMO-[0-9]{2}$"},
        "graph_id": {"$ref": "#/$defs/non_empty"},
        "criterion_label": {"$ref": "#/$defs/non_empty"},
        "query_direction": {"enum": ["backward_only"]},
        "surface": {"$ref": "#/$defs/non_empty"},
        "purpose": {"$ref": "#/$defs/non_empty"},
        "explanation_path": {"$ref": "#/$defs/path"},
        "screenshot_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_path", "required_node_ids", "required_relation_ids"],
      "properties": {
        "ledger_path": {"$ref": "#/$defs/path"},
        "required_node_ids": {"type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty"}},
        "required_relation_ids": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty"}}
      }
    }
  }
}
