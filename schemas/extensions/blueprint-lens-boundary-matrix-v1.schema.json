{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/extensions/blueprint-lens-boundary-matrix-v1.schema.json",
  "title": "Blueprint Lens LC6 Core Boundary Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "profile_id", "truth_owner", "blueprint_asset_path", "graph_id", "asset_sha256", "raw_sha256", "scenarios", "counts"],
  "properties": {
    "format": { "const": "blueprint-lens-lc6-boundary-matrix" },
    "format_version": { "const": "1.0.0" },
    "profile_id": { "const": "LC6_CORE_BOUNDARY_MATRIX_V1" },
    "truth_owner": { "const": "core_node_classification" },
    "blueprint_asset_path": { "$ref": "#/$defs/id" },
    "graph_id": { "$ref": "#/$defs/id" },
    "asset_sha256": { "$ref": "#/$defs/sha256" },
    "raw_sha256": { "$ref": "#/$defs/sha256" },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios"],
      "properties": { "scenarios": { "const": 3 } }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id"],
      "properties": {
        "kind": { "const": "semantic_boundary" },
        "node_id": { "$ref": "#/$defs/id" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "root_node_id", "criterion_node_id", "boundary_node_id", "status", "reason", "source_pin_ids", "incident_edge_ids", "slice_node_ids", "slice_edge_ids", "stop_location"],
      "properties": {
        "scenario_id": { "enum": ["LC6_OPAQUE", "LC6_UNCERTAIN", "LC6_UNSUPPORTED"] },
        "root_node_id": { "$ref": "#/$defs/id" },
        "criterion_node_id": { "$ref": "#/$defs/id" },
        "boundary_node_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["opaque", "uncertain", "unsupported"] },
        "reason": { "enum": ["function_body_not_expanded", "node_family_not_in_supported_matrix_v1", "latent_function"] },
        "source_pin_ids": { "$ref": "#/$defs/ids" },
        "incident_edge_ids": { "$ref": "#/$defs/ids" },
        "slice_node_ids": { "$ref": "#/$defs/ids" },
        "slice_edge_ids": { "$ref": "#/$defs/ids" },
        "stop_location": { "$ref": "#/$defs/stop" }
      }
    }
  }
}
