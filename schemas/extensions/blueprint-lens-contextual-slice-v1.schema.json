{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schemas/extensions/blueprint-lens-contextual-slice-v1.schema.json",
  "title": "Blueprint Lens LC5 static contextual slice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "profile_id",
    "max_call_depth",
    "status",
    "reason",
    "source_identity",
    "call_context",
    "occurrences",
    "bindings",
    "context_relations",
    "internal_relations"
  ],
  "properties": {
    "format": { "const": "blueprint-lens-intra-bp-pure-call-resolution" },
    "format_version": { "const": "1.0.0" },
    "profile_id": { "const": "LC5_INTRA_BP_PURE_CALL_V1" },
    "max_call_depth": { "const": 1 },
    "status": { "enum": ["resolved_unique", "unresolved", "ineligible", "truncated"] },
    "reason": { "type": "string" },
    "source_identity": { "$ref": "#/$defs/sourceIdentity" },
    "call_context": { "$ref": "#/$defs/callContext" },
    "occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/contextBinding" } },
    "context_relations": { "type": "array", "items": { "$ref": "#/$defs/contextRelation" } },
    "internal_relations": { "type": "array", "items": { "$ref": "#/$defs/internalRelation" } }
  },
  "oneOf": [
    {
      "required": ["status", "reason", "occurrences", "bindings", "context_relations", "internal_relations"],
      "properties": {
        "status": { "const": "resolved_unique" },
        "reason": { "const": "" },
        "occurrences": { "minItems": 2 },
        "bindings": { "minItems": 1 },
        "context_relations": { "minItems": 3 },
        "internal_relations": { "minItems": 1 }
      }
    },
    {
      "required": ["status", "reason", "occurrences", "bindings", "context_relations", "internal_relations"],
      "properties": {
        "status": { "enum": ["unresolved", "ineligible", "truncated"] },
        "reason": { "type": "string", "minLength": 1 },
        "occurrences": { "maxItems": 0 },
        "bindings": { "maxItems": 0 },
        "context_relations": { "maxItems": 0 },
        "internal_relations": { "maxItems": 0 }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_graph_id", "call_site_node_id"],
      "properties": {
        "call_graph_id": { "$ref": "#/$defs/nonEmptyString" },
        "call_site_node_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "callContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent_id", "call_site_stack", "claim_scope"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "parent_id": { "$ref": "#/$defs/nonEmptyString" },
        "call_site_stack": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "claim_scope": { "const": "static_contextual_occurrence_not_runtime_invocation" }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_node_id", "call_context_id", "occurrence_id", "role"],
      "properties": {
        "source_node_id": { "$ref": "#/$defs/nonEmptyString" },
        "call_context_id": { "$ref": "#/$defs/nonEmptyString" },
        "occurrence_id": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["call_site", "callee"] }
      }
    },
    "pinType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "subcategory", "object_path", "container", "is_reference", "is_const"],
      "properties": {
        "category": { "$ref": "#/$defs/nonEmptyString" },
        "subcategory": { "type": "string" },
        "object_path": { "type": "string" },
        "container": { "enum": ["none", "array", "set", "map"] },
        "is_reference": { "type": "boolean" },
        "is_const": { "type": "boolean" }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "direction", "cpp_type", "pin_type"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "direction": { "enum": ["input", "return"] },
        "cpp_type": { "$ref": "#/$defs/nonEmptyString" },
        "pin_type": { "$ref": "#/$defs/pinType" }
      }
    },
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "kind",
        "property",
        "call_pin_id",
        "formal_pin_id",
        "relation_kind",
        "source_occurrence_id",
        "target_occurrence_id"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["argument", "result"] },
        "property": { "$ref": "#/$defs/property" },
        "call_pin_id": { "$ref": "#/$defs/nonEmptyString" },
        "formal_pin_id": { "$ref": "#/$defs/nonEmptyString" },
        "relation_kind": { "enum": ["argument_bind", "result_bind"] },
        "source_occurrence_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_occurrence_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "contextRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_occurrence_id", "target_occurrence_id", "claim_scope"],
      "properties": {
        "kind": { "enum": ["call_enter", "argument_bind", "result_bind", "call_return"] },
        "source_occurrence_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_occurrence_id": { "$ref": "#/$defs/nonEmptyString" },
        "claim_scope": {
          "enum": [
            "static_context_boundary_not_runtime_event",
            "static_parameter_binding"
          ]
        }
      }
    },
    "internalRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_edge_id", "kind", "source_occurrence_id", "target_occurrence_id"],
      "properties": {
        "source_edge_id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["execution", "data"] },
        "source_occurrence_id": { "$ref": "#/$defs/nonEmptyString" },
        "target_occurrence_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
