{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m3-production-pipeline-report-v1.schema.json",
  "title": "Blueprint Lens M3 Production Pipeline Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_manifest_sha256",
    "normalized_runs_identical",
    "runs",
    "schema_name",
    "schema_version",
    "unique_asset_count"
  ],
  "properties": {
    "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "normalized_runs_identical": { "const": true },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/run" }
    },
    "schema_name": { "const": "blueprint-lens-m3-production-pipeline-report" },
    "schema_version": { "const": "1.0.0" },
    "unique_asset_count": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty_string": { "type": "string", "minLength": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "batch_manifest_relative_path",
        "batch_manifest_sha256",
        "run_id"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/asset" }
        },
        "batch_manifest_relative_path": { "$ref": "#/$defs/nonempty_string" },
        "batch_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "run_id": { "enum": ["run1", "run2"] }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_count",
        "graph_count",
        "node_count",
        "object_path",
        "pin_count",
        "raw_relative_path",
        "raw_sha256",
        "typed_ir_relative_path",
        "typed_ir_sha256"
      ],
      "properties": {
        "edge_count": { "type": "integer", "minimum": 0 },
        "graph_count": { "type": "integer", "minimum": 0 },
        "node_count": { "type": "integer", "minimum": 0 },
        "object_path": { "$ref": "#/$defs/nonempty_string" },
        "pin_count": { "type": "integer", "minimum": 0 },
        "raw_relative_path": { "$ref": "#/$defs/nonempty_string" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "typed_ir_relative_path": { "$ref": "#/$defs/nonempty_string" },
        "typed_ir_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
