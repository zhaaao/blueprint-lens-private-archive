{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-lens.local/schema/blueprint-lens-m3-interprocedural-readiness-v1.schema.json",
  "title": "Blueprint Lens M3 Interprocedural Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "claim_boundary",
    "evidence_bindings",
    "implementation_flags",
    "schema_name",
    "schema_version",
    "status"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/check" }
    },
    "claim_boundary": { "$ref": "#/$defs/claim_boundary" },
    "evidence_bindings": { "$ref": "#/$defs/evidence_bindings" },
    "implementation_flags": { "$ref": "#/$defs/implementation_flags" },
    "schema_name": { "const": "blueprint-lens-m3-interprocedural-readiness" },
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty_string": { "type": "string", "minLength": 1 },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "evidence", "status"],
      "properties": {
        "check_id": { "$ref": "#/$defs/nonempty_string" },
        "evidence": { "type": "object" },
        "status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["established", "not_established"],
      "properties": {
        "established": { "$ref": "#/$defs/nonempty_string" },
        "not_established": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty_string" },
          "uniqueItems": true
        }
      }
    },
    "evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_manifest_sha256",
        "corpus_manifest_sha256",
        "pipeline_report_sha256"
      ],
      "properties": {
        "batch_manifest_sha256": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "pipeline_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_blueprint_traversal_implemented",
        "macro_expansion_implemented",
        "resolution_implemented"
      ],
      "properties": {
        "cross_blueprint_traversal_implemented": { "type": "boolean" },
        "macro_expansion_implemented": { "type": "boolean" },
        "resolution_implemented": { "type": "boolean" }
      }
    }
  }
}
